	./build/bouncer-sanitize/state-properties
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -Itests -o build/bouncer-sanitize/cap-sasl tests/test_cap_sasl_final.c src/app.c src/autocommands.c src/sim.c src/protocol.c
	./build/bouncer-sanitize/cap-sasl
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -o build/bouncer-sanitize/config tests/test_bouncer_config.c src/config.c src/autocommands.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -Itests -o build/bouncer-sanitize/core tests/test_bouncer_core.c src/app.c src/autocommands.c src/sim.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -Itests -o build/bouncer-sanitize/commands $(BOUNCER_COMMAND_SRC) $(TLS_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -Itests -o build/bouncer-sanitize/setup $(BOUNCER_SETUP_SRC) $(TLS_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -Itests -o build/bouncer-sanitize/stream $(STREAM_TEST_SRC) $(TLS_LIBS)
	./build/bouncer-sanitize/config
	./build/bouncer-sanitize/core
	./build/bouncer-sanitize/commands
	./build/bouncer-sanitize/setup
	./build/bouncer-sanitize/stream

check-bouncers-terminal: onekeyirc
	$(PYTHON) tests/test_bouncer_terminal.py --binary ./onekeyirc

check-unit: check-bouncers
check-security: check-bouncers
check-security-sanitize: check-bouncers-sanitize
check-efficiency: check-stream

check-stream: build/test_idle_stream
	./build/test_idle_stream

# Descriptor ownership, pinned CA sources and parser/counter edge regressions.
BOUNDARY_BINS = build/test_background_ownership build/test_standard_fds build/test_runtime_guard_pages build/test_dcc_counter_edges
STANDARD_FDS_SRC = $(SESSION_CLI_SRC:tests/test_session_cli.c=tests/test_standard_fds.c)

build/test_background_ownership: tests/test_background_ownership.c src/background.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -o $@ tests/test_background_ownership.c

build/test_standard_fds: $(STANDARD_FDS_SRC) src/main.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -Itests -o $@ $(STANDARD_FDS_SRC) $(TLS_LIBS)

build/test_runtime_guard_pages: tests/test_runtime_guard_pages.c src/dcc.c src/editor.c src/protocol.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_runtime_guard_pages.c src/dcc.c src/editor.c src/protocol.c

build/test_dcc_counter_edges: tests/test_dcc_counter_edges.c src/dcc.c src/protocol.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_dcc_counter_edges.c src/protocol.c

check-security-boundaries: $(BOUNDARY_BINS) build/test_session_cli
	./build/test_background_ownership
	./build/test_standard_fds
	./build/test_runtime_guard_pages
	./build/test_dcc_counter_edges
	./build/test_session_cli
	CC="$(CC)" CPPFLAGS="$(CPPFLAGS)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" $(PYTHON) tests/test_net_ca.py

check-security-boundaries-sanitize: build/.stamp
	mkdir -p build/boundary-sanitize
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -o build/boundary-sanitize/ownership tests/test_background_ownership.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -Itests -o build/boundary-sanitize/standard-fds $(STANDARD_FDS_SRC) $(TLS_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -o build/boundary-sanitize/guard-pages tests/test_runtime_guard_pages.c src/dcc.c src/editor.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -o build/boundary-sanitize/dcc-counters tests/test_dcc_counter_edges.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -Itests -o build/boundary-sanitize/session-cli $(SESSION_CLI_SRC) $(TLS_LIBS)
	./build/boundary-sanitize/ownership
	./build/boundary-sanitize/standard-fds
	./build/boundary-sanitize/guard-pages
	./build/boundary-sanitize/dcc-counters
	./build/boundary-sanitize/session-cli
	CC="$(CC)" CPPFLAGS="$(CPPFLAGS)" CFLAGS="$(SANFLAGS)" LDFLAGS="$(LDFLAGS) -fsanitize=address,undefined" $(PYTHON) tests/test_net_ca.py

.PHONY: check-security-boundaries check-security-boundaries-sanitize
check-unit: check-security-boundaries
check-security: check-security-boundaries
check-security-sanitize: check-security-boundaries-sanitize

# Optional maintainer workflow; generated docs ship in source archives.
# Ordinary all/install targets need no Python interpreter.
.PHONY: docs check-docs
docs: onekeyirc
	$(PYTHON) scripts/sync_docs.py --binary ./onekeyirc

check-docs: onekeyirc
	$(PYTHON) scripts/sync_docs.py --binary ./onekeyirc --check

# Custom bindings start empty; exercise their input and persistence boundaries.
HOTKEY_COMMAND_SRC = $(COMMAND_TEST_SRC:tests/test_idle_commands.c=tests/test_hotkey_preferences.c)
HOTKEY_IDLE_SRC = $(CATCHUP_TEST_SRC:tests/test_idle_catchup.c=tests/test_idle_hotkeys.c)

build/test_hotkeys: tests/test_hotkeys.c src/config.c src/autocommands.c src/protocol.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_hotkeys.c src/config.c src/autocommands.c src/protocol.c

build/test_hotkey_preferences: $(HOTKEY_COMMAND_SRC) $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -o $@ $(HOTKEY_COMMAND_SRC) $(TLS_LIBS)

build/test_idle_hotkeys: $(HOTKEY_IDLE_SRC) src/idle.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -o $@ $(HOTKEY_IDLE_SRC) $(TLS_LIBS)

check-hotkeys: build/test_hotkeys build/test_hotkey_preferences build/test_idle_hotkeys
	./build/test_hotkeys
	./build/test_hotkey_preferences
	./build/test_idle_hotkeys

check-hotkeys-terminal: onekeyirc
	$(PYTHON) tests/test_idle_hotkeys.py --mode one


# Reproduced paste/privacy/config-creation boundaries and DCC input properties.
SECURITY_PASS_BINS = build/test_config_create build/test_replay_auth_privacy build/test_dcc_parse_properties

build/test_config_create: tests/test_config_create.c src/config.c src/autocommands.c src/protocol.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_config_create.c src/autocommands.c src/protocol.c

build/test_replay_auth_privacy: tests/test_replay_auth_privacy.c tests/test_app.c src/app.c src/autocommands.c src/sim.c src/protocol.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_replay_auth_privacy.c src/app.c src/autocommands.c src/sim.c src/protocol.c

build/test_dcc_parse_properties: tests/test_dcc_parse_properties.c src/dcc.c src/protocol.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_dcc_parse_properties.c src/dcc.c src/protocol.c

.PHONY: check-security-pass check-security-pass-sanitize
check-security-pass: $(SECURITY_PASS_BINS) check-hotkeys
	./build/test_config_create
	./build/test_replay_auth_privacy
	./build/test_dcc_parse_properties

check-security-pass-sanitize: build/.stamp
	mkdir -p build/security-pass-sanitize
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -o build/security-pass-sanitize/config-create tests/test_config_create.c src/autocommands.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -o build/security-pass-sanitize/replay-auth tests/test_replay_auth_privacy.c src/app.c src/autocommands.c src/sim.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -o build/security-pass-sanitize/dcc-parser tests/test_dcc_parse_properties.c src/dcc.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -o build/security-pass-sanitize/idle-paste $(HOTKEY_IDLE_SRC) $(TLS_LIBS)
	./build/security-pass-sanitize/config-create
	./build/security-pass-sanitize/replay-auth
	./build/security-pass-sanitize/dcc-parser
	./build/security-pass-sanitize/idle-paste

check-security: check-security-pass
check-security-sanitize: check-security-pass-sanitize

.PHONY: check-install
check-install:
	$(PYTHON) tests/test_install.py

# Recovery must release obsolete state without losing drafts or owned resources.
STABILITY_BINS = build/test_list_recovery build/test_idle_recovery build/test_credential_resources
STABILITY_IDLE_SRC = $(CATCHUP_TEST_SRC:tests/test_idle_catchup.c=tests/test_idle_recovery.c)

build/test_list_recovery: tests/test_list_recovery.c tests/test_app.c src/app.c src/autocommands.c src/sim.c src/protocol.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -Itests -o $@ tests/test_list_recovery.c src/app.c src/autocommands.c src/sim.c src/protocol.c

build/test_idle_recovery: $(STABILITY_IDLE_SRC) src/idle.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -Itests -o $@ $(STABILITY_IDLE_SRC) $(TLS_LIBS)

