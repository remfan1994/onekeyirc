	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -Itests -o $@ tests/test_credential_resources.c src/config.c src/autocommands.c src/protocol.c

.PHONY: check-stability check-stability-sanitize check-idle-load
check-stability: $(STABILITY_BINS)
	./build/test_list_recovery
	./build/test_idle_recovery
	./build/test_credential_resources

check-stability-sanitize: build/.stamp
	mkdir -p build/stability-sanitize
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -Itests -o build/stability-sanitize/list-recovery tests/test_list_recovery.c src/app.c src/autocommands.c src/sim.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -Itests -o build/stability-sanitize/idle-recovery $(STABILITY_IDLE_SRC) $(TLS_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -Itests -o build/stability-sanitize/credential-resources tests/test_credential_resources.c src/config.c src/autocommands.c src/protocol.c
	./build/stability-sanitize/list-recovery
	./build/stability-sanitize/idle-recovery
	./build/stability-sanitize/credential-resources

check-unit: check-stability
check-security: check-stability
check-security-sanitize: check-stability-sanitize

check-idle-load: onekeyirc
