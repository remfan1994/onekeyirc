.POSIX:

PREFIX = @PREFIX@
DESTDIR =
BINDIR = $(PREFIX)/bin
MANDIR = $(PREFIX)/share/man
DOCDIR = $(PREFIX)/share/doc/onekeyirc
CC = @CC@
CPPFLAGS = @CPPFLAGS@
CFLAGS = @CFLAGS@
LDFLAGS = @LDFLAGS@
TLS_LIBS = @TLS_LIBS@
PYTHON = python3
SANFLAGS = -O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer
SESSION_CLI_DEFINES = -DONEKEY_ONLY
SESSION_CLI_SRC = tests/test_session_cli.c src/summary.c src/idle_commands.c src/idle_setup.c src/client.c src/app.c src/sim.c src/net.c src/config.c src/autocommands.c src/protocol.c src/editor.c src/commands.c src/credentials.c src/nicks.c src/background.c src/dcc.c src/dcc_commands.c
SECURITY_BINS = build/test_security_app build/test_security_list build/test_security_auth build/test_dcc_file_identity build/test_process_security build/test_security_background_output build/test_idle_background_boundary build/test_session_cli build/test_security_state build/test_dcc_backpressure build/test_security_presence build/test_security_history build/test_dcc_adversarial build/test_notice_delivery build/test_credential_lifecycle build/test_security_history_flow
SECURITY_IDLE_SRC = tests/test_idle_background_boundary.c src/summary.c src/idle_commands.c src/idle_setup.c src/client.c src/app.c src/sim.c src/net.c src/config.c src/autocommands.c src/protocol.c src/editor.c src/commands.c src/credentials.c src/nicks.c src/background.c src/dcc.c src/dcc_commands.c
CATCHUP_TEST_SRC = tests/test_idle_catchup.c src/summary.c src/idle_commands.c src/idle_setup.c src/client.c src/app.c src/sim.c src/net.c src/config.c src/autocommands.c src/protocol.c src/editor.c src/commands.c src/credentials.c src/nicks.c src/background.c src/dcc.c src/dcc_commands.c

SRC = src/main.c src/summary.c src/idle.c src/idle_commands.c src/idle_setup.c src/client.c src/app.c src/sim.c src/net.c src/config.c src/autocommands.c src/protocol.c src/editor.c src/commands.c src/credentials.c src/nicks.c src/background.c src/dcc.c src/dcc_commands.c
HEADERS = src/summary.h src/dcc.h src/dcc_commands.h src/app.h src/background.h src/client.h src/commands.h src/config.h src/credentials.h src/editor.h src/idle.h src/l10n.h src/idle_commands.h src/idle_setup.h src/manual.h src/net.h src/nicks.h src/protocol.h src/sim.h src/ui.h
COMMAND_TEST_SRC = tests/test_idle_commands.c src/summary.c src/dcc.c src/idle_commands.c src/commands.c src/client.c src/app.c src/config.c src/autocommands.c src/protocol.c src/sim.c src/net.c src/credentials.c
SETUP_TEST_SRC = tests/test_idle_setup.c src/commands.c src/idle_setup.c src/client.c src/app.c src/config.c src/autocommands.c src/protocol.c src/sim.c src/net.c src/credentials.c
UNIT_BINS = build/test_summary build/test_commands build/test_dcc build/test_protocol build/test_editor build/test_nicks build/test_background build/test_config build/test_credentials build/test_app build/test_client build/test_idle_config build/test_idle_commands build/test_idle_setup build/test_roster build/test_idle_catchup

# Source-relative docs preserve README links; flat copies retain older paths.
# tests/README.md has no flat copy: README.md belongs to the project overview.
DOCFILES = doc/PRACTICAL-GUIDE-id.txt doc/PRACTICAL-GUIDE-ms.txt doc/PRACTICAL-GUIDE-tr.txt doc/PRACTICAL-GUIDE-es.txt doc/PRACTICAL-GUIDE-pt.txt doc/PRACTICAL-GUIDE-fr.txt doc/PRACTICAL-GUIDE-de.txt doc/PRACTICAL-GUIDE-ru.txt doc/PRACTICAL-GUIDE-it.txt doc/PRACTICAL-GUIDE-ar.txt doc/OPERATIONS-id.txt doc/OPERATIONS-ms.txt doc/OPERATIONS-tr.txt doc/OPERATIONS-es.txt doc/OPERATIONS-pt.txt doc/OPERATIONS-fr.txt doc/OPERATIONS-de.txt doc/OPERATIONS-ru.txt doc/OPERATIONS-it.txt doc/OPERATIONS-ar.txt doc/AUTH-BOUNCERS-id.txt doc/AUTH-BOUNCERS-ms.txt doc/AUTH-BOUNCERS-tr.txt doc/AUTH-BOUNCERS-es.txt doc/AUTH-BOUNCERS-pt.txt doc/AUTH-BOUNCERS-fr.txt doc/AUTH-BOUNCERS-de.txt doc/AUTH-BOUNCERS-ru.txt doc/AUTH-BOUNCERS-it.txt doc/AUTH-BOUNCERS-ar.txt doc/AUTH-BOUNCERS-LOCALIZATION.txt doc/CONNECTION-id.txt doc/CONNECTION-ms.txt doc/CONNECTION-tr.txt doc/CONNECTION-es.txt doc/CONNECTION-pt.txt doc/CONNECTION-fr.txt doc/CONNECTION-de.txt doc/CONNECTION-ru.txt doc/CONNECTION-it.txt doc/CONNECTION-ar.txt doc/CONNECTION-LOCALIZATION-2026-11-19.txt doc/NAVIGATION-LOCALIZATION-2026-11-19.txt doc/LOCALIZATION-UPDATE-2026-11-19.txt doc/HELP-LOCALIZATION-COVERAGE.txt doc/NAVIGATION-id.txt doc/NAVIGATION-ms.txt doc/NAVIGATION-tr.txt doc/NAVIGATION-es.txt doc/NAVIGATION-pt.txt doc/NAVIGATION-fr.txt doc/NAVIGATION-de.txt doc/NAVIGATION-ru.txt doc/NAVIGATION-it.txt doc/NAVIGATION-ar.txt doc/COMMANDS-id.txt doc/COMMANDS-ms.txt doc/COMMANDS-tr.txt doc/COMMANDS-es.txt doc/COMMANDS-pt.txt doc/COMMANDS-fr.txt doc/COMMANDS-de.txt doc/COMMANDS-ru.txt doc/COMMANDS-it.txt doc/COMMANDS-ar.txt doc/LOCALIZATION-RELEASE-2026-11-19.txt doc/TOPICS-id.txt doc/TOPICS-ms.txt doc/TOPICS-tr.txt doc/TOPICS-es.txt doc/TOPICS-pt.txt doc/TOPICS-fr.txt doc/TOPICS-de.txt doc/TOPICS-ru.txt doc/TOPICS-it.txt doc/TOPICS-ar.txt doc/START-id.txt doc/START-ms.txt doc/START-tr.txt doc/START-es.txt doc/START-pt.txt doc/START-fr.txt doc/START-de.txt doc/START-ru.txt doc/START-it.txt doc/START-ar.txt doc/USE-MODIFY-REDISTRIB