sanitize: build
	mkdir -p build/sanitize
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_palette tests/test_palette.c $(CURSES_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_filepicker tests/test_filepicker.c src/filepicker.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_protocol tests/test_protocol.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_editor tests/test_editor.c src/editor.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_nicks tests/test_nicks.c src/nicks.c src/editor.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_background tests/test_background.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_commands tests/test_commands.c src/commands.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_config tests/test_config.c src/config.c src/autocommands.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_credentials tests/test_credentials.c src/credentials.c src/config.c src/autocommands.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_credential_fields tests/test_credential_fields.c src/commands.c src/config.c src/autocommands.c src/protocol.c src/editor.c $(CURSES_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_app tests/test_app.c src/app.c src/autocommands.c src/sim.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_client tests/test_client.c src/client.c src/config.c src/autocommands.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_dcc tests/test_dcc.c src/dcc.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_status_mouse $(STATUS_MOUSE_SRC) $(CURSES_LIBS) $(TLS_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_summary $(SUMMARY_TEST_SRC) $(TLS_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_context_help $(CONTEXT_HELP_SRC) $(CURSES_LIBS) $(TLS_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_background_visibility $(BACKGROUND_VISIBILITY_SRC) $(CURSES_LIBS) $(TLS_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -o build/sanitize/vipirc $(SRC) $(CURSES_LIBS) $(TLS_LIBS)
	./build/sanitize/test_palette
	./build/sanitize/test_filepicker
	./build/sanitize/test_protocol
	./build/sanitize/test_editor
	./build/sanitize/test_nicks
	./build/sanitize/test_background
	./build/sanitize/test_commands
	./build/sanitize/test_config
	./build/sanitize/test_credentials
	./build/sanitize/test_credential_fields
	./build/sanitize/test_app
	./build/sanitize/test_client
	./build/sanitize/test_dcc
	./build/sanitize/test_status_mouse
	./build/sanitize/test_summary
	./build/sanitize/test_context_help
	./build/sanitize/test_background_visibility
	$(PYTHON) tests/test_background_start.py --binary build/sanitize/vipirc --gui
	$(PYTHON) tests/test_reconnect.py --binary build/sanitize/vipirc --gui
	VIPIRC_BINARY="`pwd`/build/sanitize/vipirc" $(PYTHON) tests/test_welcome.py
	VIPIRC_BINARY="`pwd`/build/sanitize/vipirc" $(PYTHON) tests/test_controls.py
	VIPIRC_BINARY="`pwd`/build/sanitize/vipirc" $(PYTHON) tests/test_offline.py
	VIPIRC_BINARY="`pwd`/build/sanitize/vipirc" $(PYTHON) tests/test_input_limits.py
	VIPIRC_BINARY="`pwd`/build/sanitize/vipirc" $(PYTHON) tests/test_settings.py
	VIPIRC_BINARY="`pwd`/build/sanitize/vipirc" $(PYTHON) tests/test_chat_basics.py
	VIPIRC_BINARY="`pwd`/build/sanitize/vipirc" $(PYTHON) tests/test_servers.py
	VIPIRC_BINARY="`pwd`/build/sanitize/vipirc" $(PYTHON) tests/test_transfers.py
	VIPIRC_BINARY="`pwd`/build/sanitize/vipirc" $(PYTHON) tests/test_status_navigation.py
	VIPIRC_BINARY="`pwd`/build/sanitize/vipirc" $(PYTHON) tests/test_command_prompt.py
	VIPIRC_BINARY="`pwd`/build/sanitize/vipirc" $(PYTHON) tests/test_integration.py
	VIPIRC_BINARY="`pwd`/build/sanitize/vipirc" $(PYTHON) tests/test_nick_completion.py
	VIPIRC_BINARY="`pwd`/build/sanitize/vipirc" $(PYTHON) tests/test_mouse_targets.py
	VIPIRC_BINARY="`pwd`/build/sanitize/vipirc" $(PYTHON) tests/test_background.py
	$(PYTHON) tests/test_background_replies.py --binary build/sanitize/vipirc
	VIPIRC_BINARY="`pwd`/build/sanitize/vipirc" $(PYTHON) tests/test_ui_revision.py
	VIPIRC_BINARY="`pwd`/build/sanitize/vipirc" $(PYTHON) tests/test_setup_async.py --mode gui
	VIPIRC_BINARY="`pwd`/build/sanitize/vipirc" VIPIRC_IDLE_BINARY="`pwd`/build/sanitize/vipirc" $(PYTHON) tests/test_summary_terminal.py

bench: vipirc
	$(PYTHON) tests/bench.py

STRESS_SECONDS = 60
SOAK_SECONDS = 1200

build/app-faults.o: src/app.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) -Dmalloc=app_test_malloc -Dcalloc=app_test_calloc -Drealloc=app_test_realloc -Dfree=app_test_free -c src/app.c -o $@

build/test_app_faults: tests/test_app_faults.c tests/test_app.c build/app-faults.o src/autocommands.c src/protocol.c src/sim.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_app_faults.c build/app-faults.o src/autocommands.c src/protocol.c src/sim.c

build/test_dcc_stress: tests/test_dcc_stress.c src/dcc.c src/protocol.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_dcc_stress.c src/dcc.c src/protocol.c

build/config-faults.o: src/config.c src/autocommands.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) -Dfsync=storage_test_fsync -Drenameat=storage_test_renameat -c src/config.c -o $@

build/test_storage_stress: tests/test_storage_stress.c build/config-faults.o src/app.c src/autocommands.c src/net.c src/sim.c src/credentials.c src/protocol.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_storage_stress.c build/config-faults.o src/app.c src/autocommands.c src/net.c src/sim.c src/credentials.c src/protocol.c $(TLS_LIBS)

check-stress: vipirc build/test_app_faults build/test_dcc_stress build/test_storage_stress
	./build/test_app_faults
	./build/test_storage_stress
	./build/test_dcc_stress --seconds $(STRESS_SECONDS)
	$(PYTHON) tests/test_lifecycle_stress.py
	$(PYTHON) tests/test_ui_stress.py
	$(PYTHON) tests/test_fd_pressure.py

soak: vipirc
	$(PYTHON) tests/test_soak.py --seconds $(SOAK_SECONDS) --servers 8 --tls


install: install-full

# Publish a complete new inode; running workers retain the old executable.
# Failed binary staging preserves the destination. Docs install separately.
install-full: vipirc
	mkdir -p "$(DESTDIR)$(BINDIR)" "$(DESTDIR)$(MANDIR)/man1" "$(DESTDIR)$(DOCDIR)"
	@set -eu; \
		target="$(DESTDIR)$(BINDIR)/vipirc"; \
		if [ -d "$$target" ]; then printf '%s\n' 'Refusing to install over a directory.' >&2; exit 1; fi; \
		staged=$$(mktemp "$${target}.tmp.XXXXXXXX"); \
		trap 'rm -f "$$staged"' 0; \
		trap 'exit 1' HUP INT TERM; \
		cp vipirc "$$staged"; \
		chmod 755 "$$staged"; \
		mv -f "$$staged" "$$target"; \
		trap - 0 HUP INT TERM
	cp doc/vipirc.1 "$(DESTDIR)$(MANDIR)/man1/vipirc.1"
	chmod 644 "$(DESTDIR)$(MANDIR)/man1/vipirc.1"
	@for file in $(DOCFILES); do \
		case "$$file" in */*) mkdir -p "$(DESTDIR)$(DOCDIR)/$${file%/*}" || exit 1;; esac; \
		cp "$$file" "$(DESTDIR)$(DOCDIR)/$$file" || exit 1; \
		chmod 644 "$(DESTDIR)$(DOCDIR)/$$file" || exit 1; \
		case "$$file" in tests/README.md) ;; */*) \
			cp "$$file" "$(DESTDIR)$(DOCDIR)/$${file##*/}" || exit 1; \
			chmod 644 "$(DESTDIR)$(DOCDIR)/$${file##*/}" || exit 1;; esac; \
	done

# Keep guards in this recipe, before recursive install, even under make -j.
# The executable and these text rc.d scripts are separate installed files.
.PHONY: install-openbsd-service install-openbsd-services
install-openbsd-services: install-openbsd-service

install-openbsd-service:
	@if [ "`uname -s`" != OpenBSD ]; then echo "install-openbsd-service requires OpenBSD; nothing installed." >&2; exit 1; fi
	@if [ "`id -u`" != 0 ]; then echo "Run install-openbsd-service as root." >&2; exit 1; fi
	@if [ "$(BINDIR)" != /usr/local/bin ]; then echo "The bundled OpenBSD services require BINDIR=/usr/local/bin; nothing installed." >&2; exit 1; fi
	@if [ -L "$(DESTDIR)/etc/rc.d" ] || { [ -e "$(DESTDIR)/etc/rc.d" ] && [ ! -d "$(DESTDIR)/etc/rc.d" ]; }; then echo "Refusing a symlink or non-directory rc.d destination; nothing installed." >&2; exit 1; fi
	$(MAKE) install DESTDIR="$(DESTDIR)"
	@if [ ! -d "$(DESTDIR)/etc/rc.d" ]; then /usr/bin/install -d -o root -g wheel -m 0755 "$(DESTDIR)/etc/rc.d"; fi
	/usr/bin/install -o root -g wheel -m 0555 packaging/openbsd/vipirc "$(DESTDIR)/etc/rc.d/vipirc"
	/usr/bin/install -o root -g wheel -m 0555 packaging/openbsd/vipirc_idle "$(DESTDIR)/etc/rc.d/vipirc_idle"

uninstall: uninstall-full

uninstall-full:
	rm -f "$(DESTDIR)$(BINDIR)/vipirc" "$(DESTDIR)$(MANDIR)/man1/vipirc.1"
	@for file in $(DOCFILES); do \
		rm -f "$(DESTDIR)$(DOCDIR)/$$file" || exit 1; \
		case "$$file" in tests/README.md) ;; *) \
			rm -f "$(DESTDIR)$(DOCDIR)/$${file##*/}" || exit 1;; esac; \
	done
	-rmdir "$(DESTDIR)$(DOCDIR)/doc" "$(DESTDIR)$(DOCDIR)/examples" "$(DESTDIR)$(DOCDIR)/tests"
	-rmdir "$(DESTDIR)$(DOCDIR)"

clean:
	rm -f $(STABILITY_BINS) build/stability-sanitize/list-recovery build/stability-sanitize/idle-recovery build/stability-sanitize/credential-resources
	rm -f $(SECURITY_PASS_BINS) build/security-pass-sanitize/config-create build/security-pass-sanitize/replay-auth build/security-pass-sanitize/dcc-parser build/security-pass-sanitize/idle-paste build/security-pass-sanitize/ui-paste
