# Bounded TLS, child ownership, presence and native descriptor regressions.
DEEP_BINS = build/test_presence_cancellation build/test_presence_recovery build/test_credential_descendants build/test_credential_signals build/test_background_rights
check-unit: check-deep
check-security: check-deep
check-security-sanitize: check-deep-sanitize

build/test_presence_cancellation: tests/test_presence_cancellation.c tests/test_app.c src/app.c src/autocommands.c src/sim.c src/protocol.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -Itests -o $@ tests/test_presence_cancellation.c src/app.c src/autocommands.c src/sim.c src/protocol.c

build/test_presence_recovery: tests/test_presence_recovery.c tests/test_app.c src/app.c src/autocommands.c src/sim.c src/protocol.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -Itests -o $@ tests/test_presence_recovery.c src/app.c src/autocommands.c src/sim.c src/protocol.c

build/test_credential_descendants: tests/test_credential_descendants.c tests/test_credentials.c src/credentials.c src/config.c src/autocommands.c src/protocol.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -Itests -o $@ tests/test_credential_descendants.c src/config.c src/autocommands.c src/protocol.c

build/test_credential_signals: tests/test_credential_signals.c tests/test_credentials.c src/credentials.c src/config.c src/autocommands.c src/protocol.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -Itests -o $@ tests/test_credential_signals.c src/config.c src/autocommands.c src/protocol.c

build/test_background_rights: tests/test_background_rights.c src/background.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -Itests -o $@ tests/test_background_rights.c 

check-deep: $(DEEP_BINS)
	./build/test_presence_cancellation
	./build/test_presence_recovery
	./build/test_credential_descendants
	./build/test_credential_signals
	./build/test_background_rights
	CC="$(CC)" CPPFLAGS="$(CPPFLAGS)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" $(PYTHON) tests/test_net_tls_budget.py; result=$$?; test $$result -eq 0 -o $$result -eq 77
	CC="$(CC)" CPPFLAGS="$(CPPFLAGS)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" $(PYTHON) tests/test_net_resolver_ownership.py

check-deep-sanitize: build
	mkdir -p build/deep-sanitize
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -Itests -o build/deep-sanitize/test_presence_cancellation tests/test_presence_cancellation.c src/app.c src/autocommands.c src/sim.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -Itests -o build/deep-sanitize/test_presence_recovery tests/test_presence_recovery.c src/app.c src/autocommands.c src/sim.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -Itests -o build/deep-sanitize/test_credential_descendants tests/test_credential_descendants.c src/config.c src/autocommands.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -Itests -o build/deep-sanitize/test_credential_signals tests/test_credential_signals.c src/config.c src/autocommands.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -Itests -o build/deep-sanitize/test_background_rights tests/test_background_rights.c 
	./build/deep-sanitize/test_presence_cancellation
	./build/deep-sanitize/test_presence_recovery
	./build/deep-sanitize/test_credential_descendants
	./build/deep-sanitize/test_credential_signals
	./build/deep-sanitize/test_background_rights
	CC="$(CC)" CPPFLAGS="$(CPPFLAGS)" CFLAGS="$(SANFLAGS)" LDFLAGS="$(LDFLAGS) -fsanitize=address,undefined" $(PYTHON) tests/test_net_tls_budget.py; result=$$?; test $$result -eq 0 -o $$result -eq 77
	CC="$(CC)" CPPFLAGS="$(CPPFLAGS)" CFLAGS="$(SANFLAGS)" LDFLAGS="$(LDFLAGS) -fsanitize=address,undefined" $(PYTHON) tests/test_net_resolver_ownership.py

# The retained transport harnesses honor the same instrumented toolchain.
check-security-sanitize: check-net-sanitize

check-net-sanitize:
	CC="$(CC)" CPPFLAGS="$(CPPFLAGS)" CFLAGS="$(SANFLAGS)" LDFLAGS="$(LDFLAGS) -fsanitize=address,undefined" $(PYTHON) tests/test_net.py
	CC="$(CC)" CPPFLAGS="$(CPPFLAGS)" CFLAGS="$(SANFLAGS)" LDFLAGS="$(LDFLAGS) -fsanitize=address,undefined" $(PYTHON) tests/test_net_retry.py

