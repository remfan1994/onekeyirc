.POSIX:

PREFIX = @PREFIX@
DESTDIR =
BINDIR = $(PREFIX)/bin
MANDIR = $(PREFIX)/share/man
DOCDIR = $(PREFIX)/share/doc/vipirc
CC = @CC@
CPPFLAGS = @CPPFLAGS@
CFLAGS = @CFLAGS@
LDFLAGS = @LDFLAGS@
CURSES_LIBS = @CURSES_LIBS@
TLS_LIBS = @TLS_LIBS@
PYTHON = python3
SANFLAGS = -O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer
SESSION_CLI_DEFINES = 
SESSION_CLI_SRC = tests/test_session_cli.c src/summary.c src/idle_commands.c src/idle_setup.c src/client.c src/app.c src/sim.c src/net.c src/config.c src/autocommands.c src/protocol.c src/editor.c src/commands.c src/credentials.c src/nicks.c src/background.c src/dcc.c src/dcc_commands.c
SECURITY_BINS = build/test_security_app build/test_security_list build/test_security_auth build/test_dcc_file_identity build/test_process_security build/test_security_background_output build/test_idle_background_boundary build/test_session_cli build/test_security_state build/test_dcc_backpressure build/test_security_presence build/test_security_history build/test_dcc_adversarial build/test_notice_delivery build/test_credential_lifecycle build/test_security_history_flow
SECURITY_IDLE_SRC = tests/test_idle_background_boundary.c src/summary.c src/idle_commands.c src/idle_setup.c src/client.c src/app.c src/sim.c src/net.c src/config.c src/autocommands.c src/protocol.c src/editor.c src/commands.c src/credentials.c src/nicks.c src/background.c src/dcc.c src/dcc_commands.c
CATCHUP_TEST_SRC = tests/test_idle_catchup.c src/summary.c src/idle_commands.c src/idle_setup.c src/client.c src/app.c src/sim.c src/net.c src/config.c src/autocommands.c src/protocol.c src/editor.c src/commands.c src/credentials.c src/nicks.c src/background.c src/dcc.c src/dcc_commands.c

STATUS_MOUSE_SRC = tests/test_status_mouse.c src/guided.c src/idle_setup.c src/client.c src/settings.c src/transfers.c src/filepicker.c src/dcc.c src/dcc_commands.c src/app.c src/sim.c src/config.c src/autocommands.c src/protocol.c src/editor.c src/manual.c src/commands.c src/prompt.c src/credentials.c src/nicks.c src/background.c src/idle_commands.c src/summary.c src/readpage.c
CONTEXT_HELP_SRC = tests/test_context_help.c src/guided.c src/idle_setup.c src/client.c src/settings.c src/transfers.c src/filepicker.c src/dcc.c src/dcc_commands.c src/app.c src/sim.c src/config.c src/autocommands.c src/protocol.c src/editor.c src/manual.c src/commands.c src/prompt.c src/credentials.c src/nicks.c src/background.c src/idle_commands.c src/summary.c
BACKGROUND_VISIBILITY_SRC = $(STATUS_MOUSE_SRC:tests/test_status_mouse.c=tests/test_background_visibility.c)

SRC = src/main.c src/summary.c src/readpage.c src/client.c src/ui.c src/guided.c src/settings.c src/transfers.c src/filepicker.c src/dcc.c src/dcc_commands.c src/app.c src/sim.c src/net.c src/config.c src/autocommands.c src/protocol.c src/editor.c src/manual.c src/commands.c src/prompt.c src/credentials.c src/nicks.c src/background.c src/idle.c src/idle_commands.c src/idle_setup.c
OBJ = src/main.o src/summary.o src/readpage.o src/client.o src/ui.o src/guided.o src/settings.o src/transfers.o src/filepicker.o src/dcc.o src/dcc_commands.o src/app.o src/sim.o src/net.o src/config.o src/autocommands.o src/protocol.o src/editor.o src/manual.o src/commands.o src/prompt.o src/credentials.o src/nicks.o src/background.o src/idle.o src/idle_commands.o src/idle_setup.o
HEADERS = src/summary.h src/readpage.h src/guided.h src/filepicker.h src/dcc_commands.h src/client.h src/dcc.h src/transfers.h src/app.h src/sim.h src/net.h src/config.h src/protocol.h src/editor.h src/ui.h src/settings.h src/manual.h src/license.h src/commands.h src/prompt.h src/focus.h src/credentials.h src/nicks.h src/background.h src/idle.h src/l10n.h src/idle_commands.h src/idle_setup.h

IDLE_SETUP_TEST_SRC = tests/test_idle_setup.c src/commands.c src/idle_setup.c src/client.c src/app.c src/config.c src/autocommands.c src/protocol.c src/sim.c src/net.c src/credentials.c src/manual.c
IDLE_COMMANDS_TEST_SRC = tests/test_idle_commands.c src/summary.c src/dcc.c src/idle_commands.c src/commands.c src/client.c src/app.c src/config.c src/autocommands.c src/protocol.c src/sim.c src/net.c src/credentials.c src/manual.c

# Source-relative docs preserve README links; flat copies retain older paths.
# tests/README.md has no flat copy: README.md belongs to the project overview.
DOCFILES = doc/AUTH-BOUNCERS-LOCALIZATION.txt doc/CONNECTION-LOCALIZATION-2026-11-19.txt doc/NAVIGATION-LOCALIZATION-2026-11-19.txt doc/LOCALIZATION-UPDATE-2026-11-19.txt doc/HELP-LOCALIZATION-COVERAGE.txt doc/LOCALIZATION-RELEASE-2026-11-19.txt doc/USE-MODIFY-REDISTRIBUTE.txt doc/LOCALIZATION.md doc/LOCALIZATION-CONTINUATION.txt doc/TROUBLESHOOTING.txt doc/DOCUMENTATION-REFINEMENT-0.7.36-0.1.35.txt doc/DOCUMENTATION-REFINEMENT-RESULTS.json CONTRIBUTING.md doc/SOURCE-MAP.txt tests/README.md doc/DOCUMENTATION-REVIEW-0.7.35-0.1.34.txt doc/DOCUMENTATION-PASS-RESULTS.json doc/STABILITY-REVIEW-0.7.34-0.1.33.txt doc/STABILITY-PASS-RESULTS.json doc/SECURITY-REVIEW-0.7.33-0.1.32.txt doc/SECURITY-PASS-RESULTS.json doc/HOTKEYS.txt doc/HOTKEYS-VALIDATION.txt doc/HOTKEYS-RESULTS.json README.md INSTALL DESIGN.md SECURITY.md NOTICE LICENSE.md doc/manual.txt doc/vipirc-idle-manual.txt doc/OPENBSD-VPS.txt doc/OPENBSD-VALIDATION.txt doc/ONEKEYIRC-RENAME.txt doc/SECURITY-REVIEW.txt doc/VALIDATION.txt doc/SECURITY-TEST-RESULTS.json doc/SECURITY-VALIDATION.txt doc/SESSION-CONTROLS.txt doc/SESSION-CONTROL-TEST-RESULTS.json doc/SESSION-CONTROL-VALIDATION.txt doc/DISPLAY-CLIPPING.txt doc/DISPLAY-TEST-RESULTS.json doc/TLS-RETRY-VALIDATION.txt doc/CATCHUP-VALIDATION.txt doc/PRESENCE-VALIDATION.txt doc/SECURITY-FOLLOWUP-2026-11-16.txt doc/FOLLOWUP-TEST-RESULTS.json doc/SECURITY-DEEP-REVIEW-2026-11-16.txt doc/DEEP-TEST-RESULTS.json doc/AUDIT-2026-11-15.txt doc/AUDIT-TEST-RESULTS.json doc/PRE-AUDIT-VALIDATION.txt examples/config.ini doc/BOUNCERS.txt doc/BOUNCER-VALIDATION.txt doc/BOUNCER-TEST-RESULTS.json doc/SECURITY-REVIEW-0.7.30-0.1.29.txt doc/SECURITY-BOUNDARY-RESULTS.json examples/bouncer-znc.ini examples/bouncer-soju.ini MANUAL.txt CHANGELOG.md doc/DOCUMENTATION-VALIDATION.txt doc/DOCUMENTATION-RESULTS.json doc/vipirc.1

all: vipirc

vipirc: $(OBJ)
	$(CC) $(LDFLAGS) -o $@.tmp $(OBJ) $(CURSES_LIBS) $(TLS_LIBS)
	test -s $@.tmp && test -x $@.tmp && mv -f $@.tmp $@

$(OBJ): $(HEADERS)

.c.o:
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build:
	mkdir -p build

build/test_protocol: tests/test_protocol.c src/protocol.c src/protocol.h build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_protocol.c src/protocol.c

build/test_editor: tests/test_editor.c src/editor.c src/editor.h build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_editor.c src/editor.c

build/test_nicks: tests/test_nicks.c src/nicks.c src/nicks.h src/editor.c src/protocol.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_nicks.c src/nicks.c src/editor.c src/protocol.c

build/test_background: tests/test_background.c src/background.c src/background.h $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -o $@ tests/test_background.c

build/test_commands: tests/test_commands.c src/commands.c src/protocol.c src/commands.h src/config.h src/editor.h src/protocol.h build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_commands.c src/commands.c src/protocol.c

build/test_config: tests/test_config.c src/config.c src/autocommands.c src/protocol.c src/config.h src/protocol.h build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_config.c src/config.c src/autocommands.c src/protocol.c

build/test_credentials: tests/test_credentials.c src/credentials.c src/config.c src/autocommands.c src/protocol.c src/credentials.h src/config.h src/protocol.h build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_credentials.c src/credentials.c src/config.c src/autocommands.c src/protocol.c

build/test_credential_fields: tests/test_credential_fields.c src/settings.c src/commands.c src/config.c src/autocommands.c src/protocol.c src/editor.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_credential_fields.c src/commands.c src/config.c src/autocommands.c src/protocol.c src/editor.c $(CURSES_LIBS)

check-gpg: build/test_credentials
	$(PYTHON) tests/test_credentials_gpg.py

check-setup-gpg: vipirc
	$(PYTHON) tests/test_setup_gpg.py --mode gui
	VIPIRC_IDLE_BINARY="./vipirc" $(PYTHON) tests/test_setup_gpg.py --mode idle

build/test_app: tests/test_app.c src/app.c src/autocommands.c src/sim.c src/protocol.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_app.c src/app.c src/autocommands.c src/sim.c src/protocol.c

build/test_client: tests/test_client.c src/client.c src/config.c src/autocommands.c src/protocol.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_client.c src/client.c src/config.c src/autocommands.c src/protocol.c

build/test_dcc: tests/test_dcc.c src/dcc.c src/protocol.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_dcc.c src/dcc.c src/protocol.c

build/test_status_mouse: $(STATUS_MOUSE_SRC) src/ui.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ $(STATUS_MOUSE_SRC) $(CURSES_LIBS) $(TLS_LIBS)

build/test_context_help: $(CONTEXT_HELP_SRC) tests/test_status_mouse.c src/ui.c src/readpage.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ $(CONTEXT_HELP_SRC) $(CURSES_LIBS) $(TLS_LIBS)

build/test_background_visibility: $(BACKGROUND_VISIBILITY_SRC) tests/test_status_mouse.c src/ui.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ $(BACKGROUND_VISIBILITY_SRC) $(CURSES_LIBS) $(TLS_LIBS)

