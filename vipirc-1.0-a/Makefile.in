	rm -f build/test_roster build/test_idle_catchup $(SECURITY_BINS) build/security-sanitize/test_security_history_flow build/security-sanitize/test_credential_lifecycle build/security-sanitize/test_security_presence build/security-sanitize/test_security_history build/security-sanitize/test_dcc_adversarial build/security-sanitize/test_notice_delivery build/security-sanitize/test_security_state build/security-sanitize/test_dcc_backpressure build/security-sanitize/test_roster build/security-sanitize/test_idle_catchup build/security-sanitize/test_session_cli build/security-sanitize/test_filepicker build/security-sanitize/test_status_mouse build/security-sanitize/test_config build/security-sanitize/test_commands build/idle_background_fixture build/security-sanitize/test_security_background_output build/security-sanitize/test_idle_background_boundary build/security-sanitize/test_security_app build/security-sanitize/test_security_list build/security-sanitize/test_security_auth build/security-sanitize/test_dcc_file_identity build/security-sanitize/test_protocol build/security-sanitize/test_process_security
