check-security-pass-sanitize: build
	mkdir -p build/security-pass-sanitize
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -o build/security-pass-sanitize/config-create tests/test_config_create.c src/autocommands.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -o build/security-pass-sanitize/replay-auth tests/test_replay_auth_privacy.c src/app.c src/autocommands.c src/sim.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -o build/security-pass-sanitize/dcc-parser tests/test_dcc_parse_properties.c src/dcc.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -o build/security-pass-sanitize/idle-paste $(HOTKEY_IDLE_SRC) $(TLS_LIBS)
	./build/security-pass-sanitize/config-create
	./build/security-pass-sanitize/replay-auth
	./build/security-pass-sanitize/dcc-parser
	./build/security-pass-sanitize/idle-paste
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -o build/security-pass-sanitize/ui-paste $(HOTKEY_UI_SRC) $(CURSES_LIBS) $(TLS_LIBS)
	./build/security-pass-sanitize/ui-paste

check-security: check-security-pass
check-security-sanitize: check-security-pass-sanitize

.PHONY: check-install
check-install:
	$(PYTHON) tests/test_install.py

# Recovery must release obsolete state without losing drafts or owned resources.
STABILITY_BINS = build/test_list_recovery build/test_idle_recovery build/test_credential_resources
STABILITY_IDLE_SRC = $(CATCHUP_TEST_SRC:tests/test_idle_catchup.c=tests/test_idle_recovery.c)

build/test_list_recovery: tests/test_list_recovery.c tests/test_app.c src/app.c src/autocommands.c src/sim.c src/protocol.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -Itests -o $@ tests/test_list_recovery.c src/app.c src/autocommands.c src/sim.c src/protocol.c

build/test_idle_recovery: $(STABILITY_IDLE_SRC) src/idle.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -Itests -o $@ $(STABILITY_IDLE_SRC) $(TLS_LIBS)

build/test_credential_resources: tests/test_credential_resources.c tests/test_credentials.c src/credentials.c src/config.c src/autocommands.c src/protocol.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -Itests -o $@ tests/test_credential_resources.c src/config.c src/autocommands.c src/protocol.c

.PHONY: check-stability check-stability-sanitize check-idle-load
check-stability: $(STABILITY_BINS)
	./build/test_list_recovery
	./build/test_idle_recovery
	./build/test_credential_resources

check-stability-sanitize: build
	mkdir -p build/stability-sanitize
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -Itests -o build/stability-sanitize/list-recovery tests/test_list_recovery.c src/app.c src/autocommands.c src/sim.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -Itests -o build/stability-sanitize/idle-recovery $(STABILITY_IDLE_SRC) $(TLS_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -Itests -o build/stability-sanitize/credential-resources tests/test_credential_resources.c src/config.c src/autocommands.c src/protocol.c
	./build/stability-sanitize/list-recovery
	./build/stability-sanitize/idle-recovery
	./build/stability-sanitize/credential-resources

check-unit: check-stability
check-security: check-stability
check-security-sanitize: check-stability-sanitize

check-idle-load: vipirc
	$(PYTHON) tests/test_idle_load.py --binary ./vipirc --full --tls --seconds 60

# Run independently of the network and curses frontend.
check-l10n: build
	$(CC) $(CPPFLAGS) $(CFLAGS) -Isrc -o build/test_l10n_disabled tests/test_l10n_disabled.c
	./build/test_l10n_disabled

.PHONY: check-l10n
