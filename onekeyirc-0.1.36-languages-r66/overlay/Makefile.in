all: onekeyirc

onekeyirc: $(SRC) $(HEADERS)
	$(CC) $(CPPFLAGS) $(CFLAGS) -DONEKEY_ONLY $(LDFLAGS) -o $@.tmp $(SRC) $(TLS_LIBS) $(DL_LIBS)
	test -s $@.tmp && test -x $@.tmp && mv -f $@.tmp $@

build/.stamp:
	mkdir -p build
	: > build/.stamp

build/test_protocol: tests/test_protocol.c src/protocol.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_protocol.c src/protocol.c

build/test_editor: tests/test_editor.c src/editor.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_editor.c src/editor.c $(DL_LIBS)

build/test_nicks: tests/test_nicks.c src/nicks.c src/editor.c src/protocol.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_nicks.c src/nicks.c src/editor.c src/protocol.c $(DL_LIBS)

build/test_background: tests/test_background.c src/background.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -o $@ tests/test_background.c

build/test_config: tests/test_config.c src/config.c src/autocommands.c src/protocol.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_config.c src/config.c src/autocommands.c src/protocol.c

build/test_credentials: tests/test_credentials.c src/credentials.c src/config.c src/autocommands.c src/protocol.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_credentials.c src/credentials.c src/config.c src/autocommands.c src/protocol.c

build/test_app: tests/test_app.c src/app.c src/autocommands.c src/sim.c src/protocol.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_app.c src/app.c src/autocommands.c src/sim.c src/protocol.c tests/test_l10n_stub.c

build/test_client: tests/test_client.c src/client.c src/config.c src/autocommands.c src/protocol.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_client.c src/client.c src/config.c src/autocommands.c src/protocol.c tests/test_l10n_stub.c

build/test_idle_config: tests/test_idle_config.c src/config.c src/autocommands.c src/protocol.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -o $@ tests/test_idle_config.c src/config.c src/autocommands.c src/protocol.c

build/test_idle_commands: $(COMMAND_TEST_SRC) $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -o $@ $(COMMAND_TEST_SRC) $(TLS_LIBS) $(DL_LIBS)

build/test_idle_setup: $(SETUP_TEST_SRC) $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -o $@ $(SETUP_TEST_SRC) $(TLS_LIBS) $(DL_LIBS)

check-unit: $(SECURITY_BINS) $(UNIT_BINS)
	./build/test_summary
	./build/test_commands
	./build/test_dcc
	./build/test_protocol
	./build/test_editor
	./build/test_nicks
	./build/test_background
	./build/test_config
	./build/test_credentials
	./build/test_app
	./build/test_roster
	./build/test_idle_catchup
	./build/test_security_app
	./build/test_security_list
	./build/test_security_auth
	./build/test_security_state
	./build/test_security_presence
	./build/test_security_history
	./build/test_security_history_flow
	./build/test_credential_lifecycle
	./build/test_dcc_adversarial
	./build/test_notice_delivery
	./build/test_dcc_backpressure
	./build/test_dcc_file_identity
	./build/test_process_security
	./build/test_session_cli
	./build/test_security_background_output
	./build/test_idle_background_boundary
	./build/test_client
	./build/test_idle_config
	./build/test_idle_commands
	./build/test_idle_setup

check: onekeyirc check-unit check-idle-availability check-net-retry check-rename
	VIPIRC_IDLE_BINARY="" $(PYTHON) tests/test_idle_cli.py
	VIPIRC_IDLE_BINARY="" $(PYTHON) tests/test_idle_commands.py
	$(PYTHON) tests/test_idle_terminal.py
	$(PYTHON) tests/test_idle_context.py
	$(PYTHON) tests/test_idle_setup.py
	$(PYTHON) tests/test_setup_async.py --mode one
	$(PYTHON) tests/test_setup_paths.py --mode one
	$(PYTHON) tests/test_autojoin.py --mode onekey --binary ./onekeyirc
	$(PYTHON) tests/test_idle_dcc.py
	$(PYTHON) tests/test_background_start.py
	$(PYTHON) tests/test_reconnect.py
	$(PYTHON) tests/test_sessions.py
	$(PYTHON) tests/test_background_replies.py --binary ./onekeyirc

check-gpg: build/test_credentials
	$(PYTHON) tests/test_credentials_gpg.py

check-setup-gpg: onekeyirc
	$(PYTHON) tests/test_setup_gpg.py --mode one

sanitize: build/.stamp
	mkdir -p build/sanitize
	$(CC) $(CPPFLAGS) $(SANFLAGS) -DONEKEY_ONLY $(LDFLAGS) -o build/sanitize/onekeyirc $(SRC) $(TLS_LIBS) $(DL_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -o build/sanitize/test_summary $(SUMMARY_TEST_SRC) $(TLS_LIBS) $(DL_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -o build/sanitize/test_idle_commands $(COMMAND_TEST_SRC) $(TLS_LIBS) $(DL_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -o build/sanitize/test_idle_setup $(SETUP_TEST_SRC) $(TLS_LIBS) $(DL_LIBS)
	./build/sanitize/test_summary
	./build/sanitize/test_idle_commands
	./build/sanitize/test_idle_setup
	VIPIRC_IDLE_BINARY="" ONEKEY_BINARY="`pwd`/build/sanitize/onekeyirc" $(PYTHON) tests/test_idle_cli.py
	VIPIRC_IDLE_BINARY="" ONEKEY_BINARY="`pwd`/build/sanitize/onekeyirc" $(PYTHON) tests/test_idle_commands.py
	ONEKEY_BINARY="`pwd`/build/sanitize/onekeyirc" $(PYTHON) tests/test_idle_terminal.py
	ONEKEY_BINARY="`pwd`/build/sanitize/onekeyirc" $(PYTHON) tests/test_idle_context.py
	ONEKEY_BINARY="`pwd`/build/sanitize/onekeyirc" $(PYTHON) tests/test_idle_setup.py
	ONEKEY_BINARY="`pwd`/build/sanitize/onekeyirc" $(PYTHON) tests/test_setup_async.py --mode one
	ONEKEY_BINARY="`pwd`/build/sanitize/onekeyirc" $(PYTHON) tests/test_idle_dcc.py
	ONEKEY_BINARY="`pwd`/build/sanitize/onekeyirc" $(PYTHON) tests/test_background_start.py
	ONEKEY_BINARY="`pwd`/build/sanitize/onekeyirc" $(PYTHON) tests/test_sessions.py
	$(PYTHON) tests/test_background_replies.py --binary build/sanitize/onekeyirc

# Publish a complete new inode; running workers retain the old executable.
# Failed binary staging preserves the destination. Docs install separately.
install: onekeyirc
	mkdir -p "$(DESTDIR)$(BINDIR)" "$(DESTDIR)$(MANDIR)/man1" "$(DESTDIR)$(DOCDIR)"
	@set -eu; \
		target="$(DESTDIR)$(BINDIR)/onekeyirc"; \
		if [ -d "$$target" ]; then printf '%s\n' 'Refusing to install over a directory.' >&2; exit 1; fi; \
		staged=$$(mktemp "$${target}.tmp.XXXXXXXX"); \
		trap 'rm -f "$$staged"' 0; \
		trap 'exit 1' HUP INT TERM; \
		cp onekeyirc "$$staged"; \
		chmod 755 "$$staged"; \
		mv -f "$$staged" "$$target"; \
		trap - 0 HUP INT TERM
	cp doc/onekeyirc.1 "$(DESTDIR)$(MANDIR)/man1/onekeyirc.1"
	chmod 644 "$(DESTDIR)$(MANDIR)/man1/onekeyirc.1"
	@for file in $(DOCFILES); do \
		case "$$file" in */*) mkdir -p "$(DESTDIR)$(DOCDIR)/$${file%/*}" || exit 1;; esac; \
		cp "$$file" "$(DESTDIR)$(DOCDIR)/$$file" || exit 1; \
		chmod 644 "$(DESTDIR)$(DOCDIR)/$$file" || exit 1; \
		case "$$file" in tests/README.md) ;; */*) \
			cp "$$file" "$(DESTDIR)$(DOCDIR)/$${file##*/}" || exit 1; \
			chmod 644 "$(DESTDIR)$(DOCDIR)/$${file##*/}" || exit 1;; esac; \
	done

# Keep guards in this recipe, before recursive install, even under make -j.
# The executable and the text rc.d script are separate installed files.
.PHONY: install-openbsd-service install-openbsd-services
install-openbsd-services: install-openbsd-service

install-openbsd-service:
	@if [ "`uname -s`" != OpenBSD ]; then echo "install-openbsd-service requires OpenBSD; nothing installed." >&2; exit 1; fi
	@if [ "`id -u`" != 0 ]; then echo "Run install-openbsd-service as root." >&2; exit 1; fi
	@if [ "$(BINDIR)" != /usr/local/bin ]; then echo "The bundled OpenBSD service requires BINDIR=/usr/local/bin; nothing installed." >&2; exit 1; fi
	@if [ -L "$(DESTDIR)/etc/rc.d" ] || { [ -e "$(DESTDIR)/etc/rc.d" ] && [ ! -d "$(DESTDIR)/etc/rc.d" ]; }; then echo "Refusing a symlink or non-directory rc.d destination; nothing installed." >&2; exit 1; fi
	$(MAKE) install DESTDIR="$(DESTDIR)"
	@if [ ! -d "$(DESTDIR)/etc/rc.d" ]; then /usr/bin/install -d -o root -g wheel -m 0755 "$(DESTDIR)/etc/rc.d"; fi
	/usr/bin/install -o root -g wheel -m 0555 packaging/openbsd/onekeyirc "$(DESTDIR)/etc/rc.d/onekeyirc"

uninstall:
	rm -f "$(DESTDIR)$(BINDIR)/onekeyirc" "$(DESTDIR)$(MANDIR)/man1/onekeyirc.1"
	@for file in $(DOCFILES); do \
		rm -f "$(DESTDIR)$(DOCDIR)/$$file" || exit 1; \
		case "$$file" in tests/README.md) ;; *) \
			rm -f "$(DESTDIR)$(DOCDIR)/$${file##*/}" || exit 1;; esac; \
	done
	-rmdir "$(DESTDIR)$(DOCDIR)/doc" "$(DESTDIR)$(DOCDIR)/examples" "$(DESTDIR)$(DOCDIR)/tests"
	-rmdir "$(DESTDIR)$(DOCDIR)"

clean:
	rm -f build/test_manual_localization
	rm -f build/test_localized_help_output build/test_arabic_visual_core build/test_arabic_visual_disabled
