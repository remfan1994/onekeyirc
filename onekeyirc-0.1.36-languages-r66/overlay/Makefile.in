	CC="$(CC)" CPPFLAGS="$(CPPFLAGS)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" $(PYTHON) tests/test_net_tls_budget.py; result=$$?; test $$result -eq 0 -o $$result -eq 77
