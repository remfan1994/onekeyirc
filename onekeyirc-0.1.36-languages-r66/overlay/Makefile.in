.POSIX:

PREFIX = @PREFIX@
DESTDIR =
BINDIR = $(PREFIX)/bin
MANDIR = $(PREFIX)/share/man
DOCDIR = $(PREFIX)/share/doc/onekeyirc
CC = @CC@
CPPFLAGS = @CPPFLAGS@
CFLAGS = @CFLAGS@
LDFLAGS = @LDFLAGS@
TLS_LIBS = @TLS_LIBS@
# Optional dynamic loader, kept separate from TLS for editor-only tests.
DL_LIBS = @DL_LIBS@
PYTHON = python3
SANFLAGS = -O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer
SESSION_CLI_DEFINES = -DONEKEY_ONLY
SESSION_CLI_SRC = tests/test_session_cli.c src/summary.c src/idle_commands.c src/idle_setup.c src/client.c src/app.c src/sim.c src/net.c src/config.c src/autocommands.c src/protocol.c src/editor.c src/commands.c src/credentials.c src/nicks.c src/background.c src/dcc.c src/dcc_commands.c
SECURITY_BINS = build/test_security_app build/test_security_list build/test_security_auth build/test_dcc_file_identity build/test_process_security build/test_security_background_output build/test_idle_background_boundary build/test_session_cli build/test_security_state build/test_dcc_backpressure build/test_security_presence build/test_security_history build/test_dcc_adversarial build/test_notice_delivery build/test_credential_lifecycle build/test_security_history_flow
SECURITY_IDLE_SRC = tests/test_idle_background_boundary.c src/summary.c src/idle_commands.c src/idle_setup.c src/client.c src/app.c src/sim.c src/net.c src/config.c src/autocommands.c src/protocol.c src/editor.c src/commands.c src/credentials.c src/nicks.c src/background.c src/dcc.c src/dcc_commands.c
CATCHUP_TEST_SRC = tests/test_idle_catchup.c src/summary.c src/idle_commands.c src/idle_setup.c src/client.c src/app.c src/sim.c src/net.c src/config.c src/autocommands.c src/protocol.c src/editor.c src/commands.c src/credentials.c src/nicks.c src/background.c src/dcc.c src/dcc_commands.c

SRC = src/main.c src/summary.c src/idle.c src/idle_commands.c src/idle_setup.c src/client.c src/app.c src/sim.c src/net.c src/config.c src/autocommands.c src/protocol.c src/editor.c src/commands.c src/credentials.c src/nicks.c src/background.c src/dcc.c src/dcc_commands.c
HEADERS = src/summary.h src/dcc.h src/dcc_commands.h src/app.h src/background.h src/client.h src/commands.h src/config.h src/credentials.h src/editor.h src/idle.h src/l10n.h src/arabic_visual.h src/idle_commands.h src/idle_setup.h src/manual.h src/net.h src/nicks.h src/protocol.h src/sim.h src/ui.h
COMMAND_TEST_SRC = tests/test_idle_commands.c src/summary.c src/dcc.c src/idle_commands.c src/commands.c src/client.c src/app.c src/config.c src/autocommands.c src/protocol.c src/sim.c src/net.c src/credentials.c tests/test_l10n_stub.c
SETUP_TEST_SRC = tests/test_idle_setup.c src/commands.c src/idle_setup.c src/client.c src/app.c src/config.c src/autocommands.c src/protocol.c src/sim.c src/net.c src/credentials.c
UNIT_BINS = build/test_summary build/test_commands build/test_dcc build/test_protocol build/test_editor build/test_nicks build/test_background build/test_config build/test_credentials build/test_app build/test_client build/test_idle_config build/test_idle_commands build/test_idle_setup build/test_roster build/test_idle_catchup

# Source-relative docs preserve README links; flat copies retain older paths.
# tests/README.md has no flat copy: README.md belongs to the project overview.
DOCFILES = doc/CLI-LOCALIZATION-r32.txt doc/CLI-LOCALIZATION-r32.tsv doc/TRANSLATION-STATUS-r22.txt doc/TRUST-BOUNDARY-en.txt doc/TRUST-BOUNDARY-id.txt doc/TRUST-BOUNDARY-ms.txt doc/TRUST-BOUNDARY-tr.txt doc/TRUST-BOUNDARY-es.txt doc/TRUST-BOUNDARY-pt.txt doc/TRUST-BOUNDARY-fr.txt doc/TRUST-BOUNDARY-de.txt doc/TRUST-BOUNDARY-ru.txt doc/TRUST-BOUNDARY-it.txt doc/TRUST-BOUNDARY-ar.txt doc/TRANSLATION-STATUS-r19.txt doc/SOURCE-REGIONS-r19.json  doc/TRANSLATION-STATUS-r18.txt doc/DCC-MINIMAL-en.txt doc/DCC-MINIMAL-id.txt doc/DCC-MINIMAL-ms.txt doc/DCC-MINIMAL-tr.txt doc/DCC-MINIMAL-es.txt doc/DCC-MINIMAL-pt.txt doc/DCC-MINIMAL-fr.txt doc/DCC-MINIMAL-de.txt doc/DCC-MINIMAL-ru.txt doc/DCC-MINIMAL-it.txt doc/DCC-MINIMAL-ar.txt doc/TRANSLATION-STATUS-r17.txt doc/BACKGROUND-COMMAND-en.txt doc/BACKGROUND-COMMAND-id.txt doc/BACKGROUND-COMMAND-ms.txt doc/BACKGROUND-COMMAND-tr.txt doc/BACKGROUND-COMMAND-es.txt doc/BACKGROUND-COMMAND-pt.txt doc/BACKGROUND-COMMAND-fr.txt doc/BACKGROUND-COMMAND-de.txt doc/BACKGROUND-COMMAND-ru.txt doc/BACKGROUND-COMMAND-it.txt doc/BACKGROUND-COMMAND-ar.txt doc/SECURITY-BOUNDARIES-en.txt doc/SECURITY-BOUNDARIES-id.txt doc/SECURITY-BOUNDARIES-ms.txt doc/SECURITY-BOUNDARIES-tr.txt doc/SECURITY-BOUNDARIES-es.txt doc/SECURITY-BOUNDARIES-pt.txt doc/SECURITY-BOUNDARIES-fr.txt doc/SECURITY-BOUNDARIES-de.txt doc/SECURITY-BOUNDARIES-ru.txt doc/SECURITY-BOUNDARIES-it.txt doc/SECURITY-BOUNDARIES-ar.txt doc/LOCALIZATION-SECURITY-en.txt doc/LOCALIZATION-SECURITY-id.txt doc/LOCALIZATION-SECURITY-ms.txt doc/LOCALIZATION-SECURITY-tr.txt doc/LOCALIZATION-SECURITY-es.txt doc/LOCALIZATION-SECURITY-pt.txt doc/LOCALIZATION-SECURITY-fr.txt doc/LOCALIZATION-SECURITY-de.txt doc/LOCALIZATION-SECURITY-ru.txt doc/LOCALIZATION-SECURITY-it.txt doc/LOCALIZATION-SECURITY-ar.txt doc/SETTINGS-id.txt doc/SETTINGS-ms.txt doc/SETTINGS-tr.txt doc/SETTINGS-es.txt doc/SETTINGS-pt.txt doc/SETTINGS-fr.txt doc/SETTINGS-de.txt doc/SETTINGS-ru.txt doc/SETTINGS-it.txt doc/SETTINGS-ar.txt doc/C