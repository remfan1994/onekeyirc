	$(CC) $(CPPFLAGS) $(CFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -o $@ $(LOCALIZED_HELP_TEST_SRC) $(TLS_LIBS) $(DL_LIBS)

# Optional Arabic presentation and its no-loader fallback share the same
# fixtures; code 77 records a missing optional system FriBidi library.
ARABIC_TEST_SRC = $(CATCHUP_TEST_SRC:tests/test_idle_catchup.c=tests/test_arabic_visual_core.c)
build/test_arabic_visual_core: $(ARABIC_TEST_SRC) src/idle.c src/arabic_visual.h $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -o $@ $(ARABIC_TEST_SRC) $(TLS_LIBS) $(DL_LIBS)
build/test_arabic_visual_disabled: $(ARABIC_TEST_SRC) src/idle.c src/arabic_visual.h $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) -DONEKEY_ONLY -DIRC_NO_ARABIC_VISUAL $(LDFLAGS) -Isrc -o $@ $(ARABIC_TEST_SRC) $(TLS_LIBS)
build/test_arabic_layout: tests/test_arabic_layout.c src/arabic_visual.h build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -o $@ tests/test_arabic_layout.c $(DL_LIBS)
build/test_arabic_layout_disabled: tests/test_arabic_layout.c src/arabic_visual.h build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) -DIRC_NO_ARABIC_VISUAL $(LDFLAGS) -Isrc -o $@ tests/test_arabic_layout.c
build/test_editor_visual: tests/test_editor_visual.c src/editor.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -o $@ tests/test_editor_visual.c src/editor.c $(DL_LIBS)
build/test_editor_visual_disabled: tests/test_editor_visual.c src/editor.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) -DIRC_NO_ARABIC_VISUAL $(LDFLAGS) -Isrc -o $@ tests/test_editor_visual.c src/editor.c

# This fixture includes editor.c to inject failures in all snapshot allocations.
build/test_editor_visual_failure: tests/test_editor_visual_failure.c src/editor.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -o $@ tests/test_editor_visual_failure.c $(DL_LIBS)
build/test_editor_visual_failure_disabled: tests/test_editor_visual_failure.c src/editor.c $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) -DIRC_NO_ARABIC_VISUAL $(LDFLAGS) -Isrc -o $@ tests/test_editor_visual_failure.c

check-arabic-visual: onekeyirc build/test_arabic_visual_core build/test_arabic_visual_disabled build/test_arabic_layout build/test_arabic_layout_disabled build/test_editor_visual build/test_editor_visual_disabled build/test_editor_visual_failure build/test_editor_visual_failure_disabled
	./build/test_arabic_visual_core || test $$? -eq 77
	./build/test_arabic_visual_disabled
	./build/test_arabic_layout
	./build/test_arabic_layout_disabled
	./build/test_editor_visual || test $$? -eq 77
	./build/test_editor_visual_disabled
	./build/test_editor_visual_failure || test $$? -eq 77
	./build/test_editor_visual_failure_disabled
	$(PYTHON) tests/test_arabic_visual.py --binary ./onekeyirc
	$(PYTHON) tests/test_arabic_editor_terminal.py --binary ./onekeyirc
.PHONY: check-arabic-visual

# Export complete logical UTF-8 manuals through the real command formatter.
MANUAL_LOCALIZATION_TEST_SRC = $(COMMAND_TEST_SRC:tests/test_idle_commands.c=tests/test_manual_localization.c)
build/test_manual_localization: $(MANUAL_LOCALIZATION_TEST_SRC) $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -o $@ $(MANUAL_LOCALIZATION_TEST_SRC) $(TLS_LIBS) $(DL_LIBS)

.PHONY: localized-manuals check-localized-manuals
localized-manuals: build/test_manual_localization
	$(PYTHON) tools/generate_minimal_manuals.py --fixture ./build/test_manual_localization --program onekeyirc

check-localized-manuals: build/test_manual_localization
	$(PYTHON) tools/generate_minimal_manuals.py --fixture ./build/test_manual_localization --program onekeyirc --check
	$(PYTHON) tests/test_minimal_manual_exports.py --fixture ./build/test_manual_localization --program onekeyirc

check-l10n: check-localized-manuals


# Optional language/RTL hardening regressions (also useful on their own).
build/test_localization_security: tests/test_localization_security.c src/protocol.c src/arabic_visual.h $(HEADERS) build/.stamp
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_localization_security.c src/protocol.c $(DL_LIBS)

check-l10n-security: build/test_localization_security
	./build/test_localization_security
	$(PYTHON) tests/test_localization_catalog_security.py

