# Check every translated fixed help line after the real C command reader has
# emitted/sanitized it. No IRC connection or personal configuration is used.
LOCALIZED_HELP_TEST_SRC = $(COMMAND_TEST_SRC:tests/test_idle_commands.c=tests/test_localized_help_output.c)
