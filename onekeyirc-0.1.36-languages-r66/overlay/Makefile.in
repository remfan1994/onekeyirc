	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -Itests -o build/deep-sanitize/test_credential_signals tests/test_credential_signals.c src/config.c src/autocommands.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -Itests -o build/deep-sanitize/test_background_rights tests/test_background_rights.c 
