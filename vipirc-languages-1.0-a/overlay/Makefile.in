all: vipirc

vipirc: $(OBJ)
	$(CC) $(LDFLAGS) -o $@.tmp $(OBJ) $(CURSES_LIBS) $(TLS_LIBS) $(DL_LIBS)
	test -s $@.tmp && test -x $@.tmp && mv -f $@.tmp $@

$(OBJ): $(HEADERS)

.c.o:
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build:
	mkdir -p build

build/test_protocol: tests/test_protocol.c src/protocol.c src/protocol.h build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_protocol.c src/protocol.c

build/test_editor: tests/test_editor.c src/editor.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_editor.c src/editor.c $(DL_LIBS)

build/test_nicks: tests/test_nicks.c src/nicks.c src/nicks.h src/editor.c src/protocol.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_nicks.c src/nicks.c src/editor.c src/protocol.c $(DL_LIBS)

build/test_background: tests/test_background.c src/background.c src/background.h $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -o $@ tests/test_background.c $(DL_LIBS)

build/test_commands: tests/test_commands.c src/commands.c src/protocol.c src/commands.h src/config.h src/editor.h src/protocol.h build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_commands.c src/commands.c src/protocol.c

build/test_config: tests/test_config.c src/config.c src/autocommands.c src/protocol.c src/config.h src/protocol.h build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_config.c src/config.c src/autocommands.c src/protocol.c

build/test_credentials: tests/test_credentials.c src/credentials.c src/config.c src/autocommands.c src/protocol.c src/credentials.h src/config.h src/protocol.h build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_credentials.c src/credentials.c src/config.c src/autocommands.c src/protocol.c

build/test_credential_fields: tests/test_credential_fields.c src/settings.c src/commands.c src/config.c src/autocommands.c src/protocol.c src/editor.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_credential_fields.c src/commands.c src/config.c src/autocommands.c src/protocol.c src/editor.c $(CURSES_LIBS) $(DL_LIBS)

check-gpg: build/test_credentials
	$(PYTHON) tests/test_credentials_gpg.py

check-setup-gpg: vipirc
	$(PYTHON) tests/test_setup_gpg.py --mode gui
	VIPIRC_IDLE_BINARY="./vipirc" $(PYTHON) tests/test_setup_gpg.py --mode idle

build/test_app: tests/test_app.c src/app.c src/autocommands.c src/sim.c src/protocol.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_app.c src/app.c src/autocommands.c src/sim.c src/protocol.c tests/test_l10n_stub.c

build/test_client: tests/test_client.c src/client.c src/config.c src/autocommands.c src/protocol.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_client.c src/client.c src/config.c src/autocommands.c src/protocol.c tests/test_l10n_stub.c

build/test_dcc: tests/test_dcc.c src/dcc.c src/protocol.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_dcc.c src/dcc.c src/protocol.c

build/test_status_mouse: $(STATUS_MOUSE_SRC) src/ui.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ $(STATUS_MOUSE_SRC) $(CURSES_LIBS) $(TLS_LIBS) $(DL_LIBS)

build/test_context_help: $(CONTEXT_HELP_SRC) tests/test_status_mouse.c src/ui.c src/readpage.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ $(CONTEXT_HELP_SRC) $(CURSES_LIBS) $(TLS_LIBS) $(DL_LIBS)

build/test_background_visibility: $(BACKGROUND_VISIBILITY_SRC) tests/test_status_mouse.c src/ui.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ $(BACKGROUND_VISIBILITY_SRC) $(CURSES_LIBS) $(TLS_LIBS) $(DL_LIBS)

check-unit: $(SECURITY_BINS) build/test_summary build/test_context_help build/test_background_visibility build/test_palette build/test_filepicker build/test_nicks build/test_background build/test_protocol build/test_editor build/test_commands build/test_config build/test_credentials build/test_credential_fields build/test_app build/test_client build/test_dcc build/test_status_mouse build/test_roster build/test_idle_catchup
	./build/test_palette
	./build/test_filepicker
	./build/test_protocol
	./build/test_editor
	./build/test_nicks
	./build/test_background
	./build/test_commands
	./build/test_config
	./build/test_credentials
	./build/test_credential_fields
	./build/test_app
	./build/test_roster
	./build/test_idle_catchup
	./build/test_security_app
	./build/test_security_list
	./build/test_security_auth
	./build/test_security_state
	./build/test_security_presence
	./build/test_security_history
	./build/test_security_history_flow
	./build/test_credential_lifecycle
	./build/test_dcc_adversarial
	./build/test_notice_delivery
	./build/test_dcc_backpressure
	./build/test_dcc_file_identity
	./build/test_process_security
	./build/test_session_cli
	./build/test_security_background_output
	./build/test_idle_background_boundary
	./build/test_client
	./build/test_dcc
	./build/test_status_mouse
	./build/test_summary
	./build/test_context_help
	./build/test_background_visibility

check-offline: vipirc
	$(PYTHON) tests/test_welcome.py
	$(PYTHON) tests/test_controls.py
	$(PYTHON) tests/test_offline.py
	$(PYTHON) tests/test_input_limits.py
	$(PYTHON) tests/test_settings.py --offline-only
	$(PYTHON) tests/test_chat_basics.py --offline-only
	$(PYTHON) tests/test_servers.py --offline-only
	$(PYTHON) tests/test_transfers.py --offline-only
	$(PYTHON) tests/test_status_navigation.py --offline-only
	$(PYTHON) tests/test_command_prompt.py --offline-only

check: check-full check-idle-availability

check-full: vipirc check-unit check-offline check-idle check-net-retry
	$(PYTHON) tests/test_background_start.py --binary ./vipirc --gui
	$(PYTHON) tests/test_reconnect.py --binary ./vipirc --gui
	CC="$(CC)" CPPFLAGS="$(CPPFLAGS)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" $(PYTHON) tests/test_net.py
	$(PYTHON) tests/test_integration.py
	$(PYTHON) tests/test_settings.py --live-only
	$(PYTHON) tests/test_chat_basics.py --live-only
	$(PYTHON) tests/test_servers.py --live-only
	$(PYTHON) tests/test_transfers.py --live-only
	$(PYTHON) tests/test_status_navigation.py --live-only
	$(PYTHON) tests/test_command_prompt.py --live-only
	$(PYTHON) tests/test_nick_completion.py
	$(PYTHON) tests/test_mouse_targets.py
	$(PYTHON) tests/test_background.py
	$(PYTHON) tests/test_background_replies.py --binary ./vipirc
	$(PYTHON) tests/test_ui_revision.py
	$(PYTHON) tests/test_setup_async.py --mode gui
	$(PYTHON) tests/test_setup_paths.py --mode gui
	$(PYTHON) tests/test_autojoin.py --mode gui --binary ./vipirc
	$(PYTHON) tests/test_summary_terminal.py

sanitize: build
	mkdir -p build/sanitize
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_palette tests/test_palette.c $(CURSES_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_filepicker tests/test_filepicker.c src/filepicker.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_protocol tests/test_protocol.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_editor tests/test_editor.c src/editor.c $(DL_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_nicks tests/test_nicks.c src/nicks.c src/editor.c src/protocol.c $(DL_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_background tests/test_background.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_commands tests/test_commands.c src/commands.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_config tests/test_config.c src/config.c src/autocommands.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_credentials tests/test_credentials.c src/credentials.c src/config.c src/autocommands.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_credential_fields tests/test_credential_fields.c src/commands.c src/config.c src/autocommands.c src/protocol.c src/editor.c $(CURSES_LIBS) $(DL_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_app tests/test_app.c src/app.c src/autocommands.c src/sim.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_client tests/test_client.c src/client.c src/config.c src/autocommands.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_dcc tests/test_dcc.c src/dcc.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_status_mouse $(STATUS_MOUSE_SRC) $(CURSES_LIBS) $(TLS_LIBS) $(DL_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_summary $(SUMMARY_TEST_SRC) $(TLS_LIBS) $(DL_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_context_help $(CONTEXT_HELP_SRC) $(CURSES_LIBS) $(TLS_LIBS) $(DL_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -Isrc -o build/sanitize/test_background_visibility $(BACKGROUND_VISIBILITY_SRC) $(CURSES_LIBS) $(TLS_LIBS) $(DL_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -o build/sanitize/vipirc $(SRC) $(CURSES_LIBS) $(TLS_LIBS) $(DL_LIBS)
	./build/sanitize/test_palette
	./build/sanitize/test_filepicker
	./build/sanitize/test_protocol
	./build/sanitize/test_editor
	./build/sanitize/test_nicks
	./build/sanitize/test_background
	./build/sanitize/test_commands
	./build/sanitize/test_config
	./build/sanitize/test_credentials
	./build/sanitize/test_credential_fields
	./build/sanitize/test_app
	./build/sanitize/test_client
	./build/sanitize/test_dcc
	./build/sanitize/test_status_mouse
	./build/sanitize/test_summary
	./build/sanitize/test_context_help
	./build/sanitize/test_background_visibility
	$(PYTHON) tests/test_background_start.py --binary build/sanitize/vipirc --gui
	$(PYTHON) tests/test_reconnect.py --binary build/sanitize/vipirc --gui
