	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -o $@ $(SESSION_CLI_SRC) $(TLS_LIBS) $(DL_LIBS)

.PHONY: check-session-cli
check-session-cli: build/test_session_cli
	./build/test_session_cli

# Real PTY and private IRC peer: wrap retained chat in the input view while
# keeping the complete payload and ordinary log unchanged.
.PHONY: check-idle-display
check-idle-display: vipirc
	$(PYTHON) tests/test_idle_wrapping.py --binary ./vipirc --full

# Socket-independent fixtures exercise real parsers and terminal loops.
