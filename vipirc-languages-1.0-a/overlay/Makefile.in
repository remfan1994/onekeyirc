	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -Itests -o build/bouncer-sanitize/commands $(BOUNCER_COMMAND_SRC) $(TLS_LIBS) $(DL_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -Itests -o build/bouncer-sanitize/setup $(BOUNCER_SETUP_SRC) $(TLS_LIBS) $(DL_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -Itests -o build/bouncer-sanitize/stream $(STREAM_TEST_SRC) $(TLS_LIBS) $(DL_LIBS)
	./build/bouncer-sanitize/config
	./build/bouncer-sanitize/core
	./build/bouncer-sanitize/commands
	./build/bouncer-sanitize/setup
	./build/bouncer-sanitize/stream

