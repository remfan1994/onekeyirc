	./build/test_l10n
	$(CC) $(CPPFLAGS) $(CFLAGS) -Isrc -o build/test_l10n_disabled tests/test_l10n_disabled.c
	./build/test_l10n_disabled
	$(PYTHON) tests/test_first_use_translation.py
	$(PYTHON) tools/generate_locale_first_use_guides.py --check
	$(PYTHON) tools/generate_locale_practical_guides.py --check
	$(PYTHON) tests/test_practical_help_translation.py
	$(PYTHON) tests/test_recovery_help_translation.py
	$(PYTHON) tools/generate_locale_workflow_guides.py --check
	$(PYTHON) tests/test_workflow_help_translation.py
	$(PYTHON) tools/generate_locale_config_status_guides.py --check
	$(PYTHON) tests/test_r6_help_translations.py
	$(PYTHON) tools/generate_locale_r7_guides.py --check
	$(PYTHON) tests/test_r7_translations.py
	$(PYTHON) tools/generate_locale_r8_guides.py --check
	$(PYTHON) tests/test_r8_help_translations.py
	$(PYTHON) tools/generate_help_reference.py --check
	$(PYTHON) tests/test_complete_help_translation.py --binary ./build/test_localized_help_output
	$(PYTHON) tests/test_locale_catalog.py
	$(PYTHON) tests/test_help_translation_catalog.py
	$(PYTHON) tests/test_l10n_generator.py
	$(PYTHON) tests/test_review_localizations.py
	$(PYTHON) tools/generate_locale_guides.py --check
	$(PYTHON) tools/generate_locale_topic_guides.py --check
	$(PYTHON) tests/test_detailed_help_translation.py
	$(PYTHON) tools/generate_locale_command_guides.py --check
	$(PYTHON) tools/generate_locale_navigation_guides.py --check
	$(PYTHON) tests/test_navigation_help_translation.py
	$(PYTHON) tools/generate_locale_connection_guides.py --check
	$(PYTHON) tests/test_connection_help_translation.py
	$(PYTHON) tools/generate_locale_bouncer_auth_guides.py --check
	$(PYTHON) tests/test_auth_bouncer_help_translation.py
	$(PYTHON) tools/generate_locale_operations_guides.py --check
	$(PYTHON) tests/test_operations_help_translation.py
	$(PYTHON) tools/audit_help_coverage.py --check
	$(PYTHON) tests/test_help_prose_translation.py
	$(PYTHON) tests/test_diagnostic_translation.py
	@if test -x ./vipirc; then $(PYTHON) tests/test_l10n_terminal.py --binary ./vipirc --full-client; else echo "vipirc executable unavailable; localized -i terminal smoke test skipped"; fi
	@if test -x ./vipirc; then $(PYTHON) tests/test_l10n_help_terminal.py --binary ./vipirc --full-client; else echo "vipirc executable unavailable; localized -i help test skipped"; fi
	@if test -x ./vipirc; then $(PYTHON) tests/test_l10n_topics_terminal.py --binary ./vipirc --full-client; else echo "vipirc executable unavailable; localized -i topic-help test skipped"; fi
	@if test -x ./vipirc; then $(PYTHON) tests/test_l10n_navigation_terminal.py --binary ./vipirc --full-client; else echo "vipirc executable unavailable; localized navigation help test skipped"; fi
	@if test -x ./vipirc; then $(PYTHON) tests/test_l10n_connection_terminal.py --binary ./vipirc --full-client; else echo "vipirc unavailable: connection help PTY skipped"; fi
	@if test -x ./vipirc; then $(PYTHON) tests/test_l10n_auth_bouncer_terminal.py --binary ./vipirc --full-client; else echo "vipirc unavailable: auth/bouncer help PTY skipped"; fi
	@if test -x ./vipirc; then $(PYTHON) tests/test_l10n_operations_terminal.py --binary ./vipirc --full-client; else echo "vipirc unavailable: operations help PTY skipped"; fi
	@if test -x ./vipirc; then $(PYTHON) tests/test_l10n_practical_terminal.py --binary ./vipirc --full-client; else echo "vipirc unavailable: practical help PTY skipped"; fi
	@if test -x ./vipirc; then $(PYTHON) tests/test_recovery_help_terminal.py --binary ./vipirc --full-client; else echo "vipirc unavailable: recovery PTY skipped"; fi
	@if test -x ./vipirc; then $(PYTHON) tests/test_workflow_help_terminal.py --binary ./vipirc --full-client; else echo "vipirc unavailable: workflow PTY skipped"; fi
	@if test -x ./vipirc; then $(PYTHON) tests/test_r6_help_terminal.py --binary ./vipirc --full-client; else echo "vipirc unavailable: r6 PTY skipped"; fi
	@if test -x ./vipirc; then $(PYTHON) tests/test_r7_help_terminal.py --binary ./vipirc --full-client; else echo "vipirc unavailable: r7 PTY skipped"; fi
	@if test -x ./vipirc; then $(PYTHON) tests/test_r8_help_terminal.py --binary ./vipirc --full-client; else echo "vipirc unavailable: r8 PTY skipped"; fi
	@if test -x ./vipirc; then $(PYTHON) tests/test_first_use_terminal.py --binary ./vipirc --full-client; else echo "vipirc unavailable: first-use help PTY skipped"; fi

.PHONY: check-l10n

# Check every translated fixed help line after the real C command reader has
# emitted/sanitized it. No IRC connection or personal configuration is used.
LOCALIZED_HELP_TEST_SRC = $(IDLE_COMMANDS_TEST_SRC:tests/test_idle_commands.c=tests/test_localized_help_output.c)
build/test_localized_help_output: $(LOCALIZED_HELP_TEST_SRC) tests/test_idle_commands.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ $(LOCALIZED_HELP_TEST_SRC) $(TLS_LIBS) $(DL_LIBS)

# Optional Arabic presentation and its no-loader fallback share the same
# fixtures; code 77 records a missing optional system FriBidi library.
ARABIC_TEST_SRC = $(CATCHUP_TEST_SRC:tests/test_idle_catchup.c=tests/test_arabic_visual_core.c)
build/test_arabic_visual_core: $(ARABIC_TEST_SRC) src/idle.c src/arabic_visual.h $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -o $@ $(ARABIC_TEST_SRC) $(TLS_LIBS) $(DL_LIBS)
build/test_arabic_visual_disabled: $(ARABIC_TEST_SRC) src/idle.c src/arabic_visual.h $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) -DONEKEY_ONLY -DIRC_NO_ARABIC_VISUAL $(LDFLAGS) -Isrc -o $@ $(ARABIC_TEST_SRC) $(TLS_LIBS)
build/test_arabic_layout: tests/test_arabic_layout.c src/arabic_visual.h build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -o $@ tests/test_arabic_layout.c $(DL_LIBS)
build/test_arabic_layout_disabled: tests/test_arabic_layout.c src/arabic_visual.h build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) -DIRC_NO_ARABIC_VISUAL $(LDFLAGS) -Isrc -o $@ tests/test_arabic_layout.c
build/test_editor_visual: tests/test_editor_visual.c src/editor.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -o $@ tests/test_editor_visual.c src/editor.c $(DL_LIBS)
build/test_editor_visual_disabled: tests/test_editor_visual.c src/editor.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) -DIRC_NO_ARABIC_VISUAL $(LDFLAGS) -Isrc -o $@ tests/test_editor_visual.c src/editor.c

ARABIC_NCURSES_SRC = $(STATUS_MOUSE_SRC:tests/test_status_mouse.c=tests/test_arabic_ncurses.c)
build/test_arabic_ncurses: $(ARABIC_NCURSES_SRC) tests/test_status_mouse.c src/ui.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ $(ARABIC_NCURSES_SRC) $(CURSES_LIBS) $(TLS_LIBS) $(DL_LIBS)
check-arabic-ncurses: build/test_arabic_ncurses
	./build/test_arabic_ncurses || test $$? -eq 77
.PHONY: check-arabic-ncurses

# This fixture includes editor.c to inject failures in all snapshot allocations.
build/test_editor_visual_failure: tests/test_editor_visual_failure.c src/editor.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -o $@ tests/test_editor_visual_failure.c $(DL_LIBS)
build/test_editor_visual_failure_disabled: tests/test_editor_visual_failure.c src/editor.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) -DIRC_NO_ARABIC_VISUAL $(LDFLAGS) -Isrc -o $@ tests/test_editor_visual_failure.c

check-arabic-visual: vipirc build/test_arabic_visual_core build/test_arabic_visual_disabled build/test_arabic_layout build/test_arabic_layout_disabled build/test_editor_visual build/test_editor_visual_disabled check-arabic-ncurses build/test_editor_visual_failure build/test_editor_visual_failure_disabled
	./build/test_arabic_visual_core || test $$? -eq 77
	./build/test_arabic_visual_disabled
	./build/test_arabic_layout
	./build/test_arabic_layout_disabled
	./build/test_editor_visual || test $$? -eq 77
	./build/test_editor_visual_disabled
	./build/test_editor_visual_failure || test $$? -eq 77
	./build/test_editor_visual_failure_disabled
	$(PYTHON) tests/test_arabic_visual.py --binary ./vipirc --full-client
	$(PYTHON) tests/test_arabic_editor_terminal.py --binary ./vipirc --full-client
	$(PYTHON) tests/test_arabic_editor_terminal.py --binary ./vipirc --full-client --minimalist
