# Localization regression: real command handler with fake IRC transport and loopback DCC.
check-dcc-command-l10n:
	mkdir -p build
	$(PYTHON) tools/generate_localizations.py --check
	$(PYTHON) tools/test_named_fields.py
	$(PYTHON) tests/test_dcc_validation_catalog.py
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) -D_XOPEN_SOURCE=700 $(LDFLAGS) -Isrc -o build/test_dcc_command_confirmations tests/test_dcc_command_confirmations.c src/app.c src/autocommands.c src/sim.c src/protocol.c src/dcc.c src/dcc_commands.c
	set -e; for l in en id ms tr es pt fr de ru it ar; do VIPIRC_LANG=$$l ONEKEYIRC_LANG=$$l ./build/test_dcc_command_confirmations; done

# RC2: shared report and transport display fixture; no IRC connection required.
SUMMARY_L10N_TEST_SRC = tests/test_summary_l10n.c src/summary.c src/dcc.c src/app.c src/config.c src/autocommands.c src/protocol.c src/sim.c src/net.c src/credentials.c src/manual.c
check-summary-l10n: build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -o build/test_summary_l10n $(SUMMARY_L10N_TEST_SRC) $(TLS_LIBS) $(DL_LIBS)
	@set -e; for lang in en id ms tr es pt fr de ru it ar; do ONEKEYIRC_LANG=$$lang VIPIRC_LANG=$$lang ./build/test_summary_l10n; done
.PHONY: check-summary-l10n

