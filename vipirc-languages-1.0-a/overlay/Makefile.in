localized-manuals: build/test_manual_localization
	$(PYTHON) tools/generate_minimal_manuals.py --fixture ./build/test_manual_localization --program vipirc

check-localized-manuals: build/test_manual_localization
	$(PYTHON) tools/generate_minimal_manuals.py --fixture ./build/test_manual_localization --program vipirc --check
	$(PYTHON) tests/test_minimal_manual_exports.py --fixture ./build/test_manual_localization --program vipirc

check-l10n: check-localized-manuals


# Optional language/RTL hardening regressions (also useful without curses).
build/test_localization_security: tests/test_localization_security.c src/protocol.c src/arabic_visual.h $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_localization_security.c src/protocol.c $(DL_LIBS)

# Full ncurses manual selection requires a built full-client binary.
.PHONY: check-full-manual-localization
check-full-manual-localization: vipirc
	$(PYTHON) tests/test_full_manual_export.py

check-l10n-security: build/test_localization_security
	./build/test_localization_security
	$(PYTHON) tests/test_localization_catalog_security.py

.PHONY: check-fullmanual-r22
check-fullmanual-r22:
	python3 tests/test_fullmanual_r22.py

