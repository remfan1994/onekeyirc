	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -o build/test_transport_l10n tests/test_transport_l10n.c src/app.c src/autocommands.c src/sim.c src/protocol.c
	@set -e; for lang in en id ms tr es pt fr de ru it ar; do ONEKEYIRC_LANG=$$lang VIPIRC_LANG=$$lang ./build/test_transport_l10n; done
.PHONY: check-transport-l10n

