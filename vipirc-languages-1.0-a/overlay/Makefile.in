# Optional language patch r70: formatted configuration and GPG failures.
.PHONY: check-dynamic-diagnostic-l10n
check-dynamic-diagnostic-l10n: build/.stamp
	$(PYTHON) tools/generate_localizations.py --check
	$(CC) $(CPPFLAGS) $(CFLAGS) -Isrc -o build/test_dynamic_diagnostic_l10n tests/test_dynamic_diagnostic_l10n.c
	TEST_EXPECT_TRANSLATION= ./build/test_dynamic_diagnostic_l10n
	for lang in id ms tr es pt fr de ru it ar; do VIPIRC_LANG=$$lang TEST_EXPECT_TRANSLATION=1 ./build/test_dynamic_diagnostic_l10n || exit 1; done

check-l10n-security: check-dynamic-diagnostic-l10n

