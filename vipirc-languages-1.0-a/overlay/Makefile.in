# Run explicitly on a normal host; this checks the actual terminal event loop.
check-security-idle: vipirc
	$(PYTHON) tests/test_security_idle.py --binary ./vipirc --full --seconds 90

.PHONY: check-security check-security-sanitize check-security-idle check-security-detach

build/test_security_background_output: tests/test_security_background_output.c src/background.c $(HEADERS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_security_background_output.c

build/test_idle_background_boundary: $(SECURITY_IDLE_SRC) src/idle.c $(HEADERS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) -DONEKEY_ONLY $(LDFLAGS) -Isrc -o $@ $(SECURITY_IDLE_SRC) $(TLS_LIBS) $(DL_LIBS)

build/idle_background_fixture: $(SECURITY_IDLE_SRC) src/idle.c src/main.c $(HEADERS)
	mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) -DONEKEY_ONLY -DIDLE_BOUNDARY_FIXTURE $(LDFLAGS) -Isrc -o $@ $(SECURITY_IDLE_SRC) src/main.c $(TLS_LIBS) $(DL_LIBS)

check-security-detach: build/test_idle_background_boundary build/test_security_background_output build/idle_background_fixture
