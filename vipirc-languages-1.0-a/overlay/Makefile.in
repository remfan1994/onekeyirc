# Descriptor ownership, pinned CA sources and parser/counter edge regressions.
BOUNDARY_BINS = build/test_background_ownership build/test_standard_fds build/test_runtime_guard_pages build/test_dcc_counter_edges
STANDARD_FDS_SRC = $(SESSION_CLI_SRC:tests/test_session_cli.c=tests/test_standard_fds.c)

build/test_background_ownership: tests/test_background_ownership.c tests/test_l10n_stub.c src/background.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -o $@ tests/test_background_ownership.c tests/test_l10n_stub.c $(DL_LIBS)

build/test_standard_fds: $(STANDARD_FDS_SRC) src/main.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -Itests -o $@ $(STANDARD_FDS_SRC) $(TLS_LIBS) $(DL_LIBS)

build/test_runtime_guard_pages: tests/test_runtime_guard_pages.c src/dcc.c src/editor.c src/protocol.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_runtime_guard_pages.c src/dcc.c src/editor.c src/protocol.c $(DL_LIBS)

build/test_dcc_counter_edges: tests/test_dcc_counter_edges.c src/dcc.c src/protocol.c $(HEADERS) build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -Isrc -o $@ tests/test_dcc_counter_edges.c src/protocol.c

check-security-boundaries: $(BOUNDARY_BINS) build/test_session_cli
	./build/test_background_ownership
	./build/test_standard_fds
	./build/test_runtime_guard_pages
	./build/test_dcc_counter_edges
	./build/test_session_cli
	CC="$(CC)" CPPFLAGS="$(CPPFLAGS)" CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" $(PYTHON) tests/test_net_ca.py

check-security-boundaries-sanitize: build
	mkdir -p build/boundary-sanitize
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -o build/boundary-sanitize/ownership tests/test_background_ownership.c tests/test_l10n_stub.c $(DL_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -Itests -o build/boundary-sanitize/standard-fds $(STANDARD_FDS_SRC) $(TLS_LIBS) $(DL_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -o build/boundary-sanitize/guard-pages tests/test_runtime_guard_pages.c src/dcc.c src/editor.c src/protocol.c $(DL_LIBS)
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(LDFLAGS) -Isrc -o build/boundary-sanitize/dcc-counters tests/test_dcc_counter_edges.c src/protocol.c
	$(CC) $(CPPFLAGS) $(SANFLAGS) $(SESSION_CLI_DEFINES) $(LDFLAGS) -Isrc -Itests -o build/boundary-sanitize/session-cli $(SESSION_CLI_SRC) $(TLS_LIBS) $(DL_LIBS)
	./build/boundary-sanitize/ownership
	./build/boundary-sanitize/standard-fds
	./build/boundary-sanitize/guard-pages
	./build/boundary-sanitize/dcc-counters
	./build/boundary-sanitize/session-cli
	CC="$(CC)" CPPFLAGS="$(CPPFLAGS)" CFLAGS="$(SANFLAGS)" LDFLAGS="$(LDFLAGS) -fsanitize=address,undefined" $(PYTHON) tests/test_net_ca.py

.PHONY: check-security-boundaries check-security-boundaries-sanitize
check-unit: check-security-boundaries
check-security: check-security-boundaries
check-security-sanitize: check-security-boundaries-sanitize

