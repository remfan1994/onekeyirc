SESSION_HANGUP_SRC = tests/test_idle_hangup_fixture.c src/main.c src/summary.c src/idle_commands.c src/idle_setup.c src/client.c src/app.c src/sim.c src/net.c src/config.c src/autocommands.c src/protocol.c src/editor.c src/commands.c src/credentials.c src/nicks.c src/dcc.c src/dcc_commands.c

